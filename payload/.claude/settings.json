{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/setup.sh)",
      "Bash(bash scripts/verify.sh)",
      "Bash(bash scripts/ci.sh)",
      "Bash(bash scripts/build/compile.sh)",
      "Bash(bash scripts/test/unit.sh)",
      "Bash(bash scripts/test/architecture.sh)",
      "Bash(bash scripts/test/integration.sh)",
      "Bash(bash scripts/quality/coverage.sh)",
      "Bash(bash scripts/quality/mutation.sh)",
      "Bash(bash scripts/quality/check-thresholds.sh)",
      "Bash(bash scripts/quality/enable-gates.sh --dry-run)",
      "Bash(bash scripts/agents/check-config.sh)",
      "Bash(bash scripts/agents/list-pending.sh)",
      "Bash(bash scripts/agents/detect-stack.sh)",
      "Bash(bash scripts/agents/sync-skills.sh --check)",
      "Bash(bash scripts/product/check-prd.sh)",
      "Bash(bash scripts/security/scan-secrets.sh)",
      "Bash(bash scripts/security/scan-secrets.sh --staged)",
      "Bash(bash scripts/git/guard-branch.sh)",
      "Bash(bash scripts/git/check-commit-msg.sh *)",
      "Bash(bash scripts/git/install-hooks.sh --status)",
      "Bash(bash scripts/harness-tests/*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch --show-current)"
    ],
    "ask": [
      "Bash(bash scripts/quality/enable-gates.sh --apply)",
      "Bash(bash scripts/agents/detect-stack.sh --effective)",
      "Bash(bash scripts/agents/sync-skills.sh)",
      "Bash(bash scripts/git/install-hooks.sh)",
      "Bash(bash scripts/performance/smoke.sh)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -rf *)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.harness)",
      "Write(./.harness)",
      "Edit(./docs/architecture/adr/**)",
      "Write(./docs/architecture/adr/**)",
      "Edit(./.agents/skills/**)",
      "Write(./.agents/skills/**)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.codex/**)",
      "Write(./.codex/**)",
      "Edit(./scripts/agents/hooks/**)",
      "Write(./scripts/agents/hooks/**)",
      "Edit(./.kit-manifest)",
      "Write(./.kit-manifest)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agents/hooks/claude-pre-bash.sh\""
          }
        ]
      }
    ]
  }
}
